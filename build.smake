var CXXC "/usr/bin/clang++"
var CXX_FLAGS "-std=c++23"
var BINOUT "{PROJECT_DIRECTORY}/bin"
var OBJOUT "{PROJECT_DIRECTORY}/.obj"
var LD "{CXXC}"

var SRC_FILE_0 "{PROJECT_DIRECTORY}/src/main.cpp"
var SRC_FILE_1 "{PROJECT_DIRECTORY}/src/util.cpp"

task.s checks
exec mkdir -p {BINOUT}
exec mkdir -p {OBJOUT}
task.e

task.s comp_src_file_0 -d checks
exec {CXXC} {CXX_FLAGS} -I{PROJECT_DIRECTORY}/include -I{PROJECT_DIRECTORY}/src/include -c {SRC_FILE_0} -o {OBJOUT}/src_main.cpp.o
task.e

task.s comp_src_file_1 -d checks
exec {CXXC} {CXX_FLAGS} -I{PROJECT_DIRECTORY}/include -I{PROJECT_DIRECTORY}/src/include -c {SRC_FILE_1} -o {OBJOUT}/src_util.cpp.o
task.e

task.s linker_phase -d comp_src_file_0 -d comp_src_file_1
exec {LD} {CXX_FLAGS} {OBJOUT}/src_main.cpp.o {OBJOUT}/src_util.cpp.o -o {BINOUT}/Smayke -lfreetype
task.e

